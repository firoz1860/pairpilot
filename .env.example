# ---------------------------------------------------------------------------
# PairPilot environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All secrets are read server-side only and are never exposed to the browser.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, required to run the full app) --------------------
# Example local:    postgresql://pairpilot:pairpilot@localhost:5432/pairpilot?schema=public
# Example Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://pairpilot:pairpilot@localhost:5432/pairpilot?schema=public"
# Prisma shadow DB for `migrate dev` (optional for hosted DBs that forbid it).
# SHADOW_DATABASE_URL=""

# --- App --------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth -------------------------------------------------------------------
# 32+ byte random string. Generate: `openssl rand -base64 48`
AUTH_SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"
# Session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL_SECONDS="604800"

# --- LLM provider -----------------------------------------------------------
# LLM_PROVIDER: "anthropic" uses a real model; "fixture" uses the deterministic,
# clearly-labeled simulation generator (no network, no key required).
# If "anthropic" is selected but ANTHROPIC_API_KEY is missing, agent runs FAIL
# loudly rather than silently falling back to fiction.
LLM_PROVIDER="fixture"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Hard cost ceiling per showcase run, in USD. Runs pause when exceeded.
LLM_COST_BUDGET_USD="5.00"
# Approx USD per 1M input / output tokens (used for cost accounting only).
LLM_PRICE_INPUT_PER_MTOK="3.00"
LLM_PRICE_OUTPUT_PER_MTOK="15.00"

# --- Source extraction provider --------------------------------------------
# SOURCE_PROVIDER: "fixture" serves bundled, clearly-labeled fictional source
# documents. "live" requires an authorized extraction provider (see below) and
# will return honest provider-unavailable errors if not configured.
SOURCE_PROVIDER="fixture"
# Authorized third-party extraction provider (e.g. a compliant profile API).
# Leave blank to keep live extraction disabled.
SOURCE_PROVIDER_BASE_URL=""
SOURCE_PROVIDER_API_KEY=""
# Comma-separated host allowlist for outbound extraction (SSRF guard).
SOURCE_ALLOWED_HOSTS="www.linkedin.com,linkedin.com,www.instagram.com,instagram.com"
SOURCE_HTTP_TIMEOUT_MS="10000"
SOURCE_MAX_RETRIES="3"
SOURCE_CACHE_TTL_SECONDS="86400"

# --- Background jobs (pg-boss, uses DATABASE_URL) ---------------------------
JOB_SCHEMA="pgboss"
JOB_CONCURRENCY="4"

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="30"

# --- Showcase ---------------------------------------------------------------
# Whether the public showcase route is readable without authentication.
SHOWCASE_PUBLIC="true"
